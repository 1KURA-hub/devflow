APP_ENV=prod
HTTP_ADDR=:8080
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_DATABASE=devflow
MYSQL_USER=devflow
MYSQL_DSN=devflow:change-me@tcp(mysql:3306)/devflow?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=redis:6379
RABBITMQ_DEFAULT_USER=devflow
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://devflow:change-me@rabbitmq:5672/
AUTO_MIGRATE=false
# 必须替换为至少 32 字节的随机值；留空或使用示例弱密钥时服务会拒绝启动。
JWT_SECRET=
# 拆分部署时把 server 的 worker 关掉，由独立 cmd/worker 容器消费 MQ：
# DISABLE_WORKERS=true
DISABLE_WORKERS=false
