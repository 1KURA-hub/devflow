# Midscene 需要能理解页面截图的多模态模型。
# 将本文件复制为 tests/e2e/.env，再替换为模型服务商提供的真实值。
MIDSCENE_MODEL_BASE_URL=https://your-model-provider.example.com/v1
MIDSCENE_MODEL_API_KEY=replace-with-your-api-key
MIDSCENE_MODEL_NAME=replace-with-a-vision-model-name
MIDSCENE_MODEL_FAMILY=replace-with-the-model-family

# 可选：重用已登录的 Codex App Server，该模式不需要 API Key，但可能更慢。
# MIDSCENE_MODEL_BASE_URL=codex://app-server
# MIDSCENE_MODEL_NAME=gpt-5.4
# MIDSCENE_MODEL_FAMILY=gpt-5
